# Copy this file to .env and adjust for your environment.
# Never commit .env or any real credentials.

# development | production
NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# Public origin used in password-reset links and origin checks.
# Must match the address people use in their browser.
APP_ORIGIN=http://localhost:3100

# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Persistent backend storage (relative to the project root).
DATABASE_PATH=data/housing-baazar.sqlite
STORAGE_DIR=storage

SESSION_TTL_DAYS=7
RESET_TTL_MINUTES=60

# Development only: show password-reset links on screen and in the server log.
# Must be false/absent in production. Never enable this on a public host.
DEV_SHOW_RESET_LINK=true

# Cookie flag. Leave empty in development; production defaults to true.
# COOKIE_SECURE=true

# SMTP delivery for password-reset emails. Leave SMTP_HOST/MAIL_FROM blank to
# use the development reset-link flow instead of email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Housing Baazar <no-reply@example.com>"
MAIL_REPLY_TO=support@housingbaazar.com
